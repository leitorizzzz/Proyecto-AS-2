# Configuracion de la infraestructura (docker-compose.yml).
# Copiar a .env y ajustar. NO se versiona.

# Password de la cuenta "sa" del contenedor de SQL Server.
# docker-compose se la inyecta a los tres microservicios como DB_PASSWORD,
# asi que basta definirla aqui una sola vez.
#
# Requisitos de SQL Server: minimo 8 caracteres, con mayusculas, minusculas,
# numeros y simbolos.
#
# IMPORTANTE — caracteres a evitar en la password:
#   "$"  docker-compose lo interpreta como variable.
#   "#"  dotenv lo interpreta como inicio de comentario y CORTA el valor,
#        asi que los microservicios recibirian una password truncada.
# Simbolos seguros: ! % & * - _ + =
MSSQL_SA_PASSWORD=change_me

# Secreto con el que se firman y verifican los JWT.
# DEBE ser identico en los tres microservicios (auth, farmacia y pacientes):
# auth-service firma el token y los otros dos lo verifican, asi que si no
# coincide, todo login es rechazado con "Token invalido o expirado".
# docker-compose lo inyecta a los tres desde esta unica variable.
#
# Generar uno real con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me
