# Configuracion de la infraestructura (docker-compose.yml).
# Copiar a .env (los scripts de bootstrap lo hacen por ti) y ajustar.
# Este archivo SI se versiona; .env NO (ver .gitignore).

# =============================================================
# IMPORTANTE PARA PRODUCCION
# =============================================================
# Los valores de abajo son suficientes para arrancar el sistema
# en una laptop de desarrollo con un solo comando. En produccion
# DEBEN cambiarse, especialmente MSSQL_SA_PASSWORD y JWT_SECRET.
# =============================================================

# Password de la cuenta "sa" del contenedor de SQL Server.
# docker-compose la inyecta a los 7 microservicios como DB_PASSWORD,
# asi que basta definirla aqui una sola vez.
#
# Requisitos de SQL Server: minimo 8 caracteres, con mayusculas, minusculas,
# numeros y simbolos.
#
# IMPORTANTE - caracteres a evitar en la password:
#   "$"  docker-compose lo interpreta como variable.
#   "#"  dotenv lo interpreta como inicio de comentario y CORTA el valor,
#        asi que los microservicios recibirian una password truncada.
# Simbolos seguros: ! % & * - _ + =
MSSQL_SA_PASSWORD=Asilo2026Dev!Seg

# Secreto con el que se firman y verifican los JWT.
# DEBE ser identico en los 7 microservicios: auth-service firma el token y
# los demas lo verifican. docker-compose lo inyecta desde esta unica
# variable.
#
# Para produccion, generar uno nuevo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=2c0ec796a04d51ef2924770289025e5111f58dac5b152d0d47dee25882a9ad0c9f389f290fe733283a3f27a120f32f27

# -------- Notificaciones (Brevo) --------
# API key de Brevo (ex Sendinblue). Si queda vacio o MODO_SIMULACION=true
# el servicio marca las notificaciones como enviadas sin llamar a Brevo
# (modo dev / CI).
BREVO_API_KEY=
REMITENTE_EMAIL=notificaciones@asilo.gt
MODO_SIMULACION=true

# Reintentos automaticos (job dentro del notificaciones-service)
NOTIF_MAX_INTENTOS=3
NOTIF_ESPERA_BASE_SEG=30
NOTIF_ESPERA_MAX_SEG=300
NOTIF_INTERVALO_JOB_SEG=30
