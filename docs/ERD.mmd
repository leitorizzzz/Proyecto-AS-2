%% ERD de la base de datos compartida AsiloCabezaAlgodon.
%% Generado leyendo los bootstraps SQL de cada servicio (inicializarEsquema).
%% Las columnas marcadas FK son referencias logicas; no todas tienen FK
%% declarado en SQL para permitir que los servicios arranquen en cualquier
%% orden (ej. resultados_examenes.idExamen apunta a visita_examenes).
erDiagram

    usuarios {
        INT id PK
        NVARCHAR nombre
        NVARCHAR email UK
        NVARCHAR passwordHash
        NVARCHAR rol
        DATETIME2 fechaRegistro
        BIT activo "borrado logico, default 1"
    }

    pacientes {
        INT id PK
        NVARCHAR nombres
        NVARCHAR apellidos
        DATE fechaNacimiento
        NVARCHAR genero
        NVARCHAR dpi UK
        NVARCHAR direccion
        NVARCHAR telefono
        NVARCHAR contactoEmergencia
        NVARCHAR familiarEmail
        NVARCHAR padecimientos
        DATETIME2 fechaIngreso
        BIT activo "borrado logico, default 1"
    }

    familiares {
        INT id PK
        INT idPaciente FK
        NVARCHAR nombres
        NVARCHAR apellidos
        NVARCHAR dpi "13 digitos"
        NVARCHAR parentesco
        NVARCHAR telefono
        NVARCHAR email
        NVARCHAR direccion
        BIT principal "uno principal activo por paciente"
        BIT activo
        DATETIME2 fechaRegistro
    }

    fichas_medicas {
        INT id PK
        INT idPaciente FK "UNIQUE, 1:1"
        NVARCHAR grupoSanguineo
        NVARCHAR alergias
        NVARCHAR antecedentes
        DATETIME2 fechaApertura
    }

    avisos {
        INT id PK
        INT idUsuario FK
        NVARCHAR tipo "cita_asignada"
        NVARCHAR mensaje
        INT idSolicitud FK
        BIT leido
        DATETIME2 fecha
    }

    solicitudes_referencia {
        INT id PK
        INT idPaciente FK
        INT idMedicoGeneral
        NVARCHAR especialidad
        NVARCHAR motivo
        NVARCHAR estado
        DATE fechaCita
        TIME horaCita
        INT idMedicoEspecialista
        INT idEnfermero "enfermero que acompana"
        DATETIME2 fechaCreacion
        DATETIME2 fechaActualizacion
    }

    visitas_medicas {
        INT id PK
        INT idSolicitudReferencia FK
        INT idPaciente FK
        INT idMedicoEspecialista
        DATETIME2 fecha
        NVARCHAR diagnostico
        NVARCHAR observaciones
        NVARCHAR estado "en_atencion|incompleta|completada|cancelada"
        DATETIME2 fechaCompletada
        INT idFichaMedica FK
        DECIMAL costoLaboratorio
        DECIMAL costoFarmacia
    }

    visita_examenes {
        INT id PK
        INT idVisita FK
        NVARCHAR tipo
        NVARCHAR estado
        DATETIME2 fechaSolicitud
        DECIMAL precioBase "congelado al ordenar"
        DECIMAL descuento "RN-09"
        DECIMAL costo
    }

    visita_prescripciones {
        INT id PK
        INT idVisita FK
        NVARCHAR medicamento
        NVARCHAR dosis
        NVARCHAR indicaciones
        INT idMedicamento FK
        NVARCHAR estado "pendiente|parcial|dispensada"
        INT cantidadPrescrita
        INT cantidadEntregada
        INT idDispensacion FK
        DATETIME2 fechaDispensacion
        DATETIME2 fechaPrescripcion
    }

    medicamentos {
        INT id PK
        NVARCHAR nombre
        NVARCHAR presentacion
        INT stock
        DECIMAL precioUnitario
        BIT activo "borrado logico, default 1"
    }

    dispensaciones {
        INT id PK
        INT idPaciente
        INT idVisita
        INT idMedicamento FK
        INT cantidad
        DECIMAL costoTotal
        DATETIME2 fecha
        INT idPrescripcion FK
        DECIMAL montoBase "antes del descuento"
    }

    examenes_precios {
        INT id PK
        NVARCHAR tipo UK
        DECIMAL precioBase
    }

    resultados_examenes {
        INT id PK
        INT idExamen FK
        NVARCHAR tipoResultado
        NVARCHAR valorTexto
        DECIMAL valorNumerico
        NVARCHAR archivoAdjunto
        NVARCHAR estado
        DATETIME2 fechaCreacion
        DATETIME2 fechaDisponible
    }

    cargos_servicio {
        INT id PK
        INT idPaciente FK
        NVARCHAR concepto
        DECIMAL monto
        DATETIME2 fecha
        NVARCHAR estado "pendiente|parcial|pagado"
        INT idVisita FK "UNIQUE si no es complementario"
        INT idDispensacion FK
        INT idFamiliar FK "titular"
        NVARCHAR origen "manual|visita|dispensacion"
        DECIMAL montoPagado "CHECK 0..monto"
    }

    cargos_detalle {
        INT id PK
        INT idCargo FK
        NVARCHAR rubro "consulta|laboratorio|farmacia"
        NVARCHAR descripcion
        INT idReferencia
        DECIMAL montoBase
        DECIMAL descuento
        DECIMAL monto
    }

    abonos_cargo {
        INT id PK
        INT idCargo FK
        DECIMAL monto
        NVARCHAR concepto
        INT idUsuario
        DATETIME2 fecha
    }

    tarifas_servicio {
        INT id PK
        NVARCHAR codigo UK "consulta_especialista"
        NVARCHAR descripcion
        DECIMAL precioBase
    }

    cuotas_mensuales {
        INT id PK
        INT idPaciente FK
        TINYINT mes
        SMALLINT anio
        DECIMAL monto
        NVARCHAR estado
        DATETIME2 fechaPago
        DATE fechaVencimiento "alertas naranja/roja"
    }

    donantes {
        INT id PK
        NVARCHAR nombre
        NVARCHAR telefono
        NVARCHAR email
        NVARCHAR direccion
        DATETIME2 fechaRegistro
        BIT activo "borrado logico, default 1"
    }

    donaciones {
        INT id PK
        INT idDonante FK
        DECIMAL monto
        NVARCHAR tipo
        NVARCHAR concepto
        DATETIME2 fecha
    }

    gastos_operativos {
        INT id PK
        NVARCHAR concepto
        DECIMAL monto
        NVARCHAR categoria
        DATETIME2 fecha
    }

    pagos_fundacion {
        INT id PK
        DECIMAL monto
        NVARCHAR concepto
        DATETIME2 fecha
    }

    notificaciones {
        INT id PK
        INT idPaciente
        NVARCHAR tipoEvento
        NVARCHAR destinatarioEmail
        NVARCHAR asunto
        NVARCHAR cuerpo
        NVARCHAR estado
        INT intentos
        INT maxIntentos
        DATETIME2 proximoIntento
        DATETIME2 fechaCreacion
        DATETIME2 fechaEnvio
        DATETIME2 fechaUltimoIntento
        NVARCHAR mensajeError
        NVARCHAR idMensajeProveedor "messageId de Brevo o sim-uuid"
    }

    auditoria {
        INT id PK
        NVARCHAR usuario "email del JWT"
        INT idUsuario FK
        NVARCHAR accion "crear|modificar|cancelar|desactivar|reactivar"
        NVARCHAR entidad
        INT idEntidad "id del registro auditado"
        NVARCHAR detalle
        DATETIME2 fecha "UTC"
        NVARCHAR ip
        NVARCHAR modulo
        NVARCHAR datosAnteriores "JSON"
        NVARCHAR datosNuevos "JSON"
    }

    pacientes ||--o{ solicitudes_referencia : "tiene"
    pacientes ||--o{ visitas_medicas       : "recibe"
    pacientes ||--o{ cargos_servicio       : "le aplican"
    pacientes ||--o{ cuotas_mensuales      : "paga"
    pacientes ||--o{ familiares            : "responsable"
    pacientes ||--|| fichas_medicas        : "ficha 1:1"
    fichas_medicas ||--o{ visitas_medicas  : "registra"
    familiares ||--o{ cargos_servicio      : "titular"
    visitas_medicas ||--o| cargos_servicio : "genera al cerrar"
    cargos_servicio ||--o{ cargos_detalle  : "desglosa"
    cargos_servicio ||--o{ abonos_cargo    : "recibe"
    usuarios ||--o{ avisos                 : "recibe"
    solicitudes_referencia ||--o{ avisos   : "origina"
    solicitudes_referencia ||--o| visitas_medicas : "deriva en"
    visitas_medicas ||--o{ visita_examenes       : "solicita"
    visitas_medicas ||--o{ visita_prescripciones : "prescribe"
    medicamentos    ||--o{ visita_prescripciones : "referenciado por"
    medicamentos    ||--o{ dispensaciones        : "entregado como"
    visita_prescripciones ||--o| dispensaciones  : "se dispensa como (RN-06)"
    visita_examenes ||--o| resultados_examenes   : "se completa con"
    donantes        ||--o{ donaciones            : "aporta"
    usuarios        ||--o{ solicitudes_referencia : "crea / asigna"
    usuarios        ||--o{ visitas_medicas        : "atiende"
    usuarios        ||--o{ auditoria              : "realiza"
