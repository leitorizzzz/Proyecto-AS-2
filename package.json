{
  "name": "asilo-cabeza-de-algodon",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo-lite: solo contiene scripts de prueba y de siembra para el sistema completo. Cada microservicio tiene su propio package.json con sus dependencias de produccion.",
  "scripts": {
    "test:todo": "jest --runInBand",
    "test": "jest --runInBand",
    "test:ci": "jest --runInBand --silent --json --outputFile=docs/jest-report.json",
    "test:e2e": "node scripts/e2e-smoke.js",
    "test:carga": "node scripts/carga.js",
    "seed:demo": "node scripts/seed-demo.js",
    "test:sqa": "node scripts/verificar-plan-sqa.js",
    "test:hostil": "node scripts/pruebas-hostiles.js",
    "test:integridad": "node scripts/integridad-bd.js",
    "test:caso11": "node scripts/caso11-brevo-caido.js",
    "test:ui": "node scripts/ui-sqa.js",
    "enlace-recuperacion": "node scripts/enlace-recuperacion.js"
  },
  "devDependencies": {
    "bcryptjs": "^2.4.3",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "jest": "^29.7.0",
    "jsonwebtoken": "^9.0.3",
    "pdfjs-dist": "^3.11.174",
    "pdfkit": "^0.15.2",
    "playwright": "^1.48.2",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/**/__tests__/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "verbose": true
  }
}
