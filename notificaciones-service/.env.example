PORT=3006

DB_SERVER=localhost
DB_PORT=1433
DB_NAME=AsiloCabezaAlgodon
DB_USER=sa
DB_PASSWORD=change_me
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

JWT_SECRET=change_me_super_secret

# Brevo (ex Sendinblue) - API transaccional
BREVO_API_KEY=xkeysib-your-api-key-here
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
REMITENTE_EMAIL=notificaciones@asilo.gt
REMITENTE_NOMBRE=Asilo Cabeza de Algodon

# Si esta en true, no se llama a Brevo; se guarda la notificacion como enviada
# de todos modos (util para dev/testing sin quemar cuota del proveedor).
MODO_SIMULACION=true

# Reintentos de notificaciones. El job dentro del propio proceso recorre
# cada NOTIF_INTERVALO_JOB_SEG. Un fallo duplica la espera a partir de
# NOTIF_ESPERA_BASE_SEG, con tope NOTIF_ESPERA_MAX_SEG. Al alcanzar
# NOTIF_MAX_INTENTOS la notificacion queda en 'fallida_definitiva'.
NOTIF_MAX_INTENTOS=3
NOTIF_ESPERA_BASE_SEG=30
NOTIF_ESPERA_MAX_SEG=300
NOTIF_INTERVALO_JOB_SEG=30
